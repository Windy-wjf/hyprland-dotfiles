#!/usr/bin/env python3
"""waybar 天气模块：数据来自 wttr.in，10 分钟缓存，失败时回退旧数据。"""
import json, os, sys, time, urllib.parse, urllib.request

DEFAULT_CITY = ""  # 空 = 按 IP 自动定位（wttr.in 自动识别）
_HERE = os.path.dirname(os.path.abspath(__file__))
CITY_FILE = os.path.join(_HERE, "weather.city")
CACHE = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/run/user/%d" % os.getuid(),
                     "waybar-weather.json")
TTL = 600


def city_setting():
    """读取 weather.city 的第一行非注释内容；为空则用 IP 自动定位。"""
    try:
        with open(CITY_FILE, encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#"):
                    return line
    except OSError:
        pass
    return DEFAULT_CITY

DESC = {
    "113": "晴", "116": "多云", "119": "阴", "122": "阴",
    "143": "薄雾", "248": "雾", "260": "冻雾", "149": "烟霾",
    "176": "零星小雨", "263": "零星毛毛雨", "266": "毛毛雨",
    "293": "零星小雨", "296": "小雨", "299": "中雨", "302": "中雨",
    "305": "大雨", "308": "大雨",
    "311": "冻雨", "314": "冻雨", "317": "冻毛毛雨", "320": "冻毛毛雨",
    "350": "冰粒", "374": "冰粒", "377": "冰粒",
    "353": "小阵雨", "356": "中阵雨", "359": "大阵雨",
    "362": "雨夹雪", "365": "雨夹雪",
    "368": "小阵雪", "371": "大阵雪",
    "227": "吹雪", "230": "暴风雪",
    "179": "零星阵雪", "182": "零星雨夹雪", "185": "冻毛毛雨",
    "281": "冻毛毛雨", "284": "冻毛毛雨",
    "200": "雷暴", "386": "雷阵雨", "389": "强雷阵雨",
    "392": "雷阵雪", "395": "强雷阵雪",
    "323": "小雪", "326": "小雪", "329": "中雪", "332": "中雪",
    "335": "大雪", "338": "大雪",
}

SUN = "\ue368"; PARTLY = "\ue302"; CLOUD = "\ue312"; FOG = "\ue313"
DRIZZLE = "\ue314"; RAIN = "\ue318"; SLEET = "\ue336"; SNOW = "\ue335"; THUNDER = "\ue32a"

ICON = {
    "113": SUN, "116": PARTLY, "119": CLOUD, "122": CLOUD,
    "143": FOG, "248": FOG, "260": FOG, "149": FOG,
    "176": DRIZZLE, "263": DRIZZLE, "266": DRIZZLE, "353": DRIZZLE,
    "293": RAIN, "296": RAIN, "299": RAIN, "302": RAIN,
    "305": RAIN, "308": RAIN, "356": RAIN, "359": RAIN,
    "311": SLEET, "314": SLEET, "317": SLEET, "320": SLEET,
    "350": SLEET, "362": SLEET, "365": SLEET,
    "374": RAIN, "377": RAIN, "182": SLEET, "185": SLEET,
    "281": SLEET, "284": SLEET,
    "227": SNOW, "230": SNOW, "179": SNOW, "323": SNOW, "326": SNOW,
    "329": SNOW, "332": SNOW, "335": SNOW, "338": SNOW,
    "368": SNOW, "371": SNOW,
    "200": THUNDER, "386": THUNDER, "389": THUNDER, "392": THUNDER, "395": THUNDER,
}

def classify(code):
    if code in ("113", "116"):
        return "sunny"
    if code in ("200", "386", "389", "392", "395"):
        return "storm"
    if code in ("227", "230", "179", "323", "326", "329", "332", "335", "338", "368", "371"):
        return "snow"
    if code in ("176", "263", "266", "293", "296", "299", "302", "305", "308",
                "311", "314", "317", "320", "350", "353", "356", "359", "362", "365",
                "374", "377", "281", "284", "185", "182"):
        return "rain"
    if code in ("143", "248", "260"):
        return "fog"
    return "cloudy"

def fetch(name):
    if name:
        url = "https://wttr.in/" + urllib.parse.quote(name) + "?format=j1"
    else:
        url = "https://wttr.in/?format=j1"
    req = urllib.request.Request(url, headers={"User-Agent": "curl/8"})
    with urllib.request.urlopen(req, timeout=8) as r:
        return json.load(r)

def load_cache():
    try:
        with open(CACHE) as f:
            d = json.load(f)
        return d.get("data"), d.get("ts", 0), d.get("city", "")
    except Exception:
        return None, 0, ""

def save_cache(name, data):
    tmp = CACHE + ".tmp"
    with open(tmp, "w") as f:
        json.dump({"ts": time.time(), "city": name, "data": data}, f, ensure_ascii=False)
    os.replace(tmp, CACHE)

def main():
    text_mode = "--text" in sys.argv
    name = city_setting()
    data, ts, cached_city = load_cache()
    if not data or cached_city != name or time.time() - ts > TTL:
        try:
            data = fetch(name)
            save_cache(name, data)
        except Exception:
            pass
    if not data:
        if text_mode:
            print("天气获取失败")
        else:
            print(json.dumps({"text": "—", "tooltip": "天气获取失败", "class": "cloudy"}, ensure_ascii=False))
        return

    c = data["current_condition"][0]
    code = c["weatherCode"]
    temp = c["temp_C"]
    feels = c["FeelsLikeC"]
    hum = c["humidity"]
    wind = c["windspeedKmph"]
    desc = DESC.get(code, c["weatherDesc"][0]["value"])
    icon = ICON.get(code, SUN)

    area = data["nearest_area"][0]
    city = area["areaName"][0]["value"]
    city_cn = {"Pootung": "浦东", "Shanghai": "上海", "Hangzhou": "杭州",
               "Beijing": "北京", "Guangzhou": "广州", "Shenzhen": "深圳",
               "Chengdu": "成都", "Nanjing": "南京", "Suzhou": "苏州",
               "Chingpaichiang": "成都 · 青白江区"}.get(city, city)

    days = data["weather"]
    today = days[0]
    lines = [
        f"{city_cn} · {desc}",
        f"温度 {temp}°C（体感 {feels}°C）",
        f"湿度 {hum}% · 风速 {wind} km/h",
        f"今日 {today['maxtempC']}° / {today['mintempC']}°",
    ]
    if len(days) > 1:
        t = days[1]
        lines.append(f"明日 {t['maxtempC']}° / {t['mintempC']}°")
    obs = c.get("observation_time", "")
    if obs:
        try:
            hhmm, ampm = obs.split()
            h, m = hhmm.split(":")
            h = int(h) % 12 + (12 if ampm == "PM" else 0)
            obs = f"{h:02d}:{m}"
        except Exception:
            pass
        lines.append(f"更新 {obs}")
    lines.append("点击查看详情")

    if text_mode:
        print(f"{icon}  {city_cn} · {desc} · {temp}°C（体感 {feels}°C）")
        return

    print(json.dumps({
        "text": f"{icon} {temp}°",
        "tooltip": "\n".join(lines),
        "class": classify(code),
    }, ensure_ascii=False))

if __name__ == "__main__":
    main()
