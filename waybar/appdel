#!/usr/bin/env python3
"""从应用快捷图标组里删除一个应用。

用法：appdel <id>    # 直接删除指定应用（图标右键用）
      appdel         # 弹出列表，选择要删除的图标（状态栏「−」按钮用）
"""
import json
import os
import shutil
import subprocess
import sys

H = os.path.expanduser("~/.config/waybar")
REG = os.path.join(H, "apps.json")


def notify(msg):
    if shutil.which("notify-send"):
        subprocess.run(["notify-send", "应用图标", msg], check=False)
    else:
        print(msg)


def load():
    with open(REG, encoding="utf-8") as f:
        return json.load(f)


def save(data):
    with open(REG, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=2)
        f.write("\n")


def pick(apps):
    labels = [f"{chr(int(a['icon'], 16))}   {a['name']}" for a in apps]
    cmd = [
        "fuzzel",
        "--dmenu",
        "--prompt", "删除图标",
        "--lines", str(min(len(labels), 12)),
        "--width", "30",
    ]
    try:
        res = subprocess.run(cmd, input="\n".join(labels) + "\n",
                             capture_output=True, text=True)
    except FileNotFoundError:
        notify("找不到 fuzzel")
        return None
    if res.returncode != 0:
        return None
    choice = res.stdout.strip()
    for app, label in zip(apps, labels):
        if label == choice:
            return app["id"]
    return None


def main():
    data = load()
    apps = data.get("apps", [])

    if len(sys.argv) == 2:
        target = sys.argv[1]
    elif len(sys.argv) == 1:
        if not apps:
            notify("当前没有可删除的图标")
            return 0
        target = pick(apps)
        if not target:
            return 0
    else:
        print("用法: appdel [id]")
        return 1

    kept = [a for a in apps if a["id"] != target]
    if len(kept) == len(apps):
        print(f"没有找到 {target}")
        return 1

    data["apps"] = kept
    save(data)
    print(f"已删除 {target}")
    subprocess.run([os.path.join(H, "appsync")])
    return 0


if __name__ == "__main__":
    sys.exit(main())
