#!/usr/bin/env python3
"""工作区按钮状态：输出 {"text":"N","class":"active|occupied|"}"""
import json, os, sys, time, subprocess

CACHE = "/run/user/%d/waybar-wss.json" % os.getuid()


def hyprctl(args):
    r = subprocess.run(["hyprctl", "-j"] + args, capture_output=True, text=True, timeout=3)
    return json.loads(r.stdout) if r.stdout.strip() else None


def refresh():
    act = hyprctl(["activeworkspace"])
    wss = hyprctl(["workspaces"])
    data = {
        "ts": time.time(),
        "active": act.get("id", -1) if isinstance(act, dict) else -1,
        "counts": {w["id"]: w.get("windows", 0) for w in wss} if isinstance(wss, list) else {},
    }
    try:
        with open(CACHE, "w") as f:
            json.dump(data, f)
    except OSError:
        pass
    return data


def state():
    try:
        with open(CACHE) as f:
            d = json.load(f)
        d["counts"] = {int(k): v for k, v in d.get("counts", {}).items()}
        if time.time() - d.get("ts", 0) < 0.2:
            return d
    except Exception:
        pass
    return refresh()


i = int(sys.argv[1])
d = state()
exists = i in d.get("counts", {}) or i == d.get("active")
if not exists:
    print(json.dumps({"text": "", "class": ""}))
    raise SystemExit(0)
if i == d.get("active"):
    cls = "active"
elif d.get("counts", {}).get(i, 0) > 0:
    cls = "occupied"
else:
    cls = ""
print(json.dumps({"text": str(i), "class": cls}))
